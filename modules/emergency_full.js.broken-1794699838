// 5. ابزارهای کمکی بالینی
// ═══════════════════════════════════════════════════════════════
function now() { return new Date().toISOString(); }
function today() { return new Date().toISOString().slice(0, 10); }
function minutesBetween(a, b) {
  if (!a || !b) return null;
  const ms = sd(b) - sd(a);
  return ms >= 0 ? Math.round(ms / 60000) : null;
}

/** NEWS2 score (از سینا) */
function news2(v) {
  if (!v) return null;
  let s = 0, n = 0;
  if (v.rr != null) {
    n++; s += v.rr <= 8 ? 3 : v.rr <= 11 ? 1 : v.rr <= 20 ? 0 : v.rr <= 24 ? 2 : 3;
  }
  if (v.spo2 != null) {
    n++; s += v.spo2 <= 91 ? 3 : v.spo2 <= 93 ? 2 : v.spo2 <= 95 ? 1 : 0;
  }
  if (v.onOxygen) s += 2;
  if (v.sbp != null) {
    n++; s += v.sbp <= 90 ? 3 : v.sbp <= 100 ? 2 : v.sbp <= 110 ? 1 : v.sbp <= 219 ? 0 : 3;
  }
  if (v.hr != null) {
    n++; s += v.hr <= 40 ? 3 : v.hr <= 50 ? 1 : v.hr <= 90 ? 0 : v.hr <= 110 ? 1 : v.hr <= 130 ? 2 : 3;
  }
  if (v.temp != null) {
    n++; s += v.temp <= 35 ? 3 : v.temp <= 36 ? 1 : v.temp <= 38 ? 0 : v.temp <= 39 ? 1 : 2;
  }
  if (v.gcs != null) {
    n++; s += v.gcs < 15 ? 3 : 0;
  }
  return n === 0 ? null : s;
}

/** پیشنهاد ESI بر اساس شکایت + علائم حیاتی + NEWS2 */
function computeSuggestedESI(chiefComplaint, vitals) {
  const cc = (chiefComplaint || '').toLowerCase();
  const n2 = news2(vitals);
  let level = 5;
  const reasons = [];

  // Red flags → ESI 1
  if (vitals) {
    if (vitals.gcs != null && vitals.gcs <= 8) { level = 1; reasons.push('GCS ≤ 8'); }
    if (vitals.sbp != null && vitals.sbp < 80) { level = 1; reasons.push('شوک (SBP < 80)'); }
    if (vitals.spo2 != null && vitals.spo2 < 85) { level = Math.min(level, 1); reasons.push('هیپوکسی شدید'); }
    if (vitals.rr != null && (vitals.rr < 8 || vitals.rr > 35)) { level = Math.min(level, 1); reasons.push('نارسایی تنفسی'); }
  }
  if (/ایست قلب|کد ۹۹|بدون نبض|آپنه|سیانوز شدید/.test(cc)) {
    level = 1; reasons.push('شکایت بحرانی');
  }

  // ESI 2
  if (level > 2) {
    if (n2 != null && n2 >= 7) { level = 2; reasons.push('NEWS2 ≥ 7'); }
    if (vitals && vitals.sbp != null && vitals.sbp < 100) { level = 2; reasons.push('SBP < 100'); }
    if (vitals && vitals.spo2 != null && vitals.spo2 < 92) { level = Math.min(level, 2); reasons.push('SpO2 < 92'); }
    if (/درد قفسه سینه|تنگی نفس شدید|سکته|همی‌پارزی|تشنج|خونریزی فعال|ترومای متعدد|سقوط از ارتفاع/.test(cc)) {
      level = Math.min(level, 2); reasons.push('شکایت پرخطر');
    }
  }

  // ESI 3
  if (level > 3) {
    if (n2 != null && n2 >= 5) { level = 3; reasons.push('NEWS2 ۵-۶'); }
    if (/درد شدید|تب بالا|استفراغ مکرر|شکستگی|ضربه به سر|خونریزی گوارشی/.test(cc)) {
      level = Math.min(level, 3); reasons.push('شکایت متوسط-شدید');
    }
  }

  // ESI 4
  if (level > 4) {
    if (/درد خفیف|زخم سطحی|تهوع|سردرد|عفونت ادراری|گلودرد/.test(cc)) {
      level = 4; reasons.push('شکایت غیرفوری');
    }
  }

  return { level, reasons, news2: n2, maxWait: ESI[level - 1].maxWait };
}

